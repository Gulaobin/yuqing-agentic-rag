      "must": [
        [
          "(?<!\\d)7天",
          "七天"
        ],
        [
          "(?<!\\d)10个",
          "十个"
        ],
        [
          "(?<!\\d)10分钟",
          "十分钟"
        ]
      ],
      "evidence_any": [
        "MTH-002",
        "MTH-003"
      ]
    },
    {
      "id": "C3",
      "type": "知识跨文档",
      "question": "二级舆情事件的上报时限和首次回应时限分别是什么？",
      "must": [
        [
          "当天",
          "24时",
          "24点"
        ],
        [
          "(?<!\\d)12小时",
          "十二小时"
        ]
      ],
      "evidence_any": [
        "STD-002",
        "STD-003"
      ]
    },
    {
      "id": "S1",
      "type": "实例单跳",
      "question": "EVT-0012 的热度峰值出现在首帖后第几小时？峰值那一小时有多少条帖子？",
      "must": [
        [
          "第19小时",
