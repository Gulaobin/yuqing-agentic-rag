      ]
    },
    {
      "id": "M3",
      "type": "实例多跳",
      "question": "EVT-0007 有没有疑似协同转发？如果有，涉及多少个账号、转发的是哪条帖子？",
      "must": [
        [
          "(?<!\\d)40个",
          "(?<!\\d)40\\b"
        ],
        [
          "P0007-0022"
        ]
      ],
      "evidence_any": [
        "P0007-0022"
      ]
    },
    {
      "id": "R1",
      "type": "应拒答",
      "question": "EVT-0003 的责任单位是哪家公司？",
