      "must": [
        [
          "二级",
          "2级"
        ],
        [
          "当天",
          "24时",
          "24点"
        ]
      ],
      "evidence_any": [
        "STD-001",
        "STD-002"
      ]
    },
    {
      "id": "C2",
      "type": "知识跨文档",
