    },
    {
      "id": "R2",
      "type": "应拒答",
      "question": "EVT-0021 在首帖 5 天之后的热度怎么样？",
      "refuse": true
    },
    {
      "id": "R3",
      "type": "应拒答",
      "question": "禾沐科技裁员事件（EVT-0007）中，公司一共裁了多少名员工？",
      "refuse": true,
      "must_not": [
